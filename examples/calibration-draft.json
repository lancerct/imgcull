  "parent_id": null,
  "change": "Separate redundancy from poor quality; capture user correction and scene counterexamples. Declarative cases, not a vision benchmark.",
  "rules": [
    {
      "id": "purpose-first",
      "tags": [],
      "text": "Identify artistic, personal, documentary and synthesis purposes before marking. Unresolved purposes remain unmarked."
    },
    {
      "id": "redundancy",
      "tags": [
        "near_duplicate",
        "burst"
      ],
      "text": "After verifying native detail/current appearance, retain a sound equally good or better representative and red redundant frames without unique value. No low-score requirement. Hash similarity only proposes comparison."
    },
    {
      "id": "distinct-moments",
      "tags": [
        "portrait",
        "bird",
        "burst"
      ],
      "text": "Keep all worthwhile different expressions/actions/behaviors; no fixed keeper count. If no good frame exists, retain the best meaningful representative, optionally unstarred."
    },
    {
      "id": "protect-inputs",
      "tags": [
        "stack",
        "astro",
        "bracket",
        "panorama"
      ],
      "text": "Protect synthesis inputs as a sequence; do not select just one because frames look alike."
    },
    {
      "id": "record-value",
      "tags": [
        "exhibit",
        "documentary",
        "bird"
      ],
      "text": "Account for useful species, behavior, object, inscription and angle differences; portfolio aesthetics alone do not define value."
    },
    {
      "id": "concrete-edits",
      "tags": [],
      "text": "Suggest green only for retained frames with a concrete useful adjustment based on current LR appearance; RAW alone does not require green."
    },
    {
      "id": "evidence-first",
      "tags": [],
      "text": "Preferences cannot override original native inspection, current LR appearance, uncertainty, protected sequences or metadata safety gates."
    }
  ],
